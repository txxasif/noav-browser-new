# Per-machine engine tuning — TEMPLATE (ships with the build, safe to keep).
# On first install: copy this file to `.env.local` (same folder as server.js)
# and edit values there. `.env.local` is never overwritten by updates and never
# ships back out. The server loads it at startup; every worker inherits it.
# Restart the app after changing `.env.local`.
#
# Current production values (2026-10-06, 60-slot Meta/IG + extension captcha):
INSTA_V8_HEAP_MB=128
INSTA_INPROCESS_AUDIO=1
INSTA_DENSE_RENDER=1
INSTA_MAX_IMAGE_MB=32
INSTA_VISUAL_CAPTCHA_TIMEOUT=30
INSTA_VISUAL_CAPTCHA_BAIL=15

# --- Browserless IG private-API path (opt-in; default OFF = existing browser) --
# IG_API_MODE=1        # enable the API path: rename + cookie via the API;
#                      # follow/2FA fall back to the browser (session reuse, no
#                      # login) because IG blocks the raw API login ("out of date").
# IG_API_MOCK=1        # API mode only: submit a MOCK 2FA key (skip real 2FA).

# --- Egress proxy (rotating residential / mobile) -----------------------------
# PROXY_URL=http://user:pass@gate.provider.com:8000
#   Sticky per account:  PROXY_URL=http://user-session-{session}:pass@gate:8000
#   {session} is replaced per account -> each account gets its own IP.
#   Unset = direct connection (unchanged). Also routed into the browser.
# PROXY_URL=

# --- Egress timezone (must match the proxy/IP) --------------------------------
# The browser + JS timezone is derived automatically from the public IP (or the
# PROXY_URL country token). A fingerprint timezone that disagrees with the egress
# IP is a classic automation flag. Override explicitly if auto-detect is wrong
# or you are offline:
# INSTA_TZ=Asia/Singapore
# How often to re-detect (seconds). 0 = on every browser launch. Default 60.
# INSTA_TZ_TTL=60
